# Glowbook Environment Variables

# Netlify & Next.js Public URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Configured for Postgres, Auth, Realtime, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron Secret for automated billing renewal checks (/api/cron/billing)
CRON_SECRET=glowbook_secure_cron_secret_sample_key_123

# Optional: Email & Messaging Providers (defaults to Console Mock in dev)
RESEND_API_KEY=
WHATSAPP_API_TOKEN=
